<?xml version="1.0" encoding="UTF-8"?>
<!-- e4 application model (T011). Layout skeleton only: the part stacks below
     are the stable extension anchors published in iped.rcp.api/ModelAnchors
     (ui-extension-api contract); parts are contributed by later tasks
     (US1+). Window label is set by the lifecycle from the i18n adapter. -->
<application:Application xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:advanced="http://www.eclipse.org/ui/2010/UIModel/application/ui/advanced"
    xmlns:application="http://www.eclipse.org/ui/2010/UIModel/application"
    xmlns:basic="http://www.eclipse.org/ui/2010/UIModel/application/ui/basic"
    xmlns:commands="http://www.eclipse.org/ui/2010/UIModel/application/commands"
    xmlns:menu="http://www.eclipse.org/ui/2010/UIModel/application/ui/menu"
    xmi:id="_app" elementId="iped.rcp.app.application" bindingContexts="_ctxDialogAndWindow" selectedElement="_window">
  <children xsi:type="basic:TrimmedWindow" xmi:id="_window" elementId="iped.rcp.app.trimmedwindow.main" label="IPED" width="1400" height="900" selectedElement="_perspectiveStack">
    <!-- Main menu (T044/T045, US5): labels are localized at runtime by the
         lifecycle (central catalogs, research R7); theme radio selection is
         synchronized from the persisted preference on every boot. -->
    <mainMenu xmi:id="_menuMain" elementId="iped.rcp.app.menu.main">
      <children xsi:type="menu:Menu" xmi:id="_menuFile" elementId="iped.rcp.app.menu.file" label="File">
        <children xsi:type="menu:HandledMenuItem" xmi:id="_miNewCase" elementId="iped.rcp.app.menuitem.newcase" label="New Case..." command="_cmdNewCase"/>
        <children xsi:type="menu:HandledMenuItem" xmi:id="_miOpenCase" elementId="iped.rcp.app.menuitem.opencase" label="Open Case..." command="_cmdOpenCase"/>
        <children xsi:type="menu:MenuSeparator" xmi:id="_miFileSep1" elementId="iped.rcp.app.menu.file.sep1"/>
        <children xsi:type="menu:HandledMenuItem" xmi:id="_miManageProfiles" elementId="iped.rcp.app.menuitem.manageprofiles" label="Manage Profiles..." command="_cmdManageProfiles"/>
        <children xsi:type="menu:MenuSeparator" xmi:id="_miFileSep2" elementId="iped.rcp.app.menu.file.sep2"/>
        <children xsi:type="menu:HandledMenuItem" xmi:id="_miExit" elementId="iped.rcp.app.menuitem.exit" label="Exit" command="_cmdExit"/>
      </children>
      <children xsi:type="menu:Menu" xmi:id="_menuView" elementId="iped.rcp.app.menu.view" label="View">
        <children xsi:type="menu:Menu" xmi:id="_menuTheme" elementId="iped.rcp.app.menu.theme" label="Theme">
          <children xsi:type="menu:DirectMenuItem" xmi:id="_miThemeSystem" elementId="iped.rcp.app.menuitem.theme.system" label="System" type="Radio" contributionURI="bundleclass://iped.rcp.app/iped.rcp.app.theme.SetThemeHandler$System"/>
          <children xsi:type="menu:DirectMenuItem" xmi:id="_miThemeLight" elementId="iped.rcp.app.menuitem.theme.light" label="Light" type="Radio" contributionURI="bundleclass://iped.rcp.app/iped.rcp.app.theme.SetThemeHandler$Light"/>
          <children xsi:type="menu:DirectMenuItem" xmi:id="_miThemeDark" elementId="iped.rcp.app.menuitem.theme.dark" label="Dark" type="Radio" contributionURI="bundleclass://iped.rcp.app/iped.rcp.app.theme.SetThemeHandler$Dark"/>
        </children>
        <children xsi:type="menu:MenuSeparator" xmi:id="_miViewSep1" elementId="iped.rcp.app.menu.view.sep1"/>
        <children xsi:type="menu:DirectMenuItem" xmi:id="_miUiScale" elementId="iped.rcp.app.menuitem.uiscale" label="UI Scale..." contributionURI="bundleclass://iped.rcp.app/iped.rcp.app.settings.UiScaleHandler"/>
      </children>
      <children xsi:type="menu:Menu" xmi:id="_menuHelp" elementId="iped.rcp.app.menu.help" label="Help">
        <children xsi:type="menu:HandledMenuItem" xmi:id="_miAbout" elementId="iped.rcp.app.menuitem.about" label="About IPED" command="_cmdAbout"/>
      </children>
    </mainMenu>
    <!-- Top toolbar: quick access to the case entry points. Icon-only items
         (the label is shown as the tooltip, localized at runtime); the standard
         "new"/"open" art is shipped in this bundle under icons/ with @1.5x/@2x
         HiDPI variants. The two HandledToolItems reuse the File-menu commands. -->
    <trimBars xmi:id="_trimTop" elementId="iped.rcp.app.trimbar.top" side="Top">
      <children xsi:type="menu:ToolBar" xmi:id="_toolbarMain" elementId="iped.rcp.app.toolbar.main">
        <children xsi:type="menu:HandledToolItem" xmi:id="_tiNewCase" elementId="iped.rcp.app.toolitem.newcase" label="New Case" tooltip="New Case" iconURI="platform:/plugin/iped.rcp.app/icons/new_case.png" command="_cmdNewCase"/>
        <children xsi:type="menu:HandledToolItem" xmi:id="_tiOpenCase" elementId="iped.rcp.app.toolitem.opencase" label="Open Case" tooltip="Open Case" iconURI="platform:/plugin/iped.rcp.app/icons/open_case.png" command="_cmdOpenCase"/>
      </children>
    </trimBars>
    <children xsi:type="advanced:PerspectiveStack" xmi:id="_perspectiveStack" elementId="iped.rcp.app.perspectivestack" selectedElement="_perspectiveMain">
      <children xsi:type="advanced:Perspective" xmi:id="_perspectiveMain" elementId="iped.rcp.app.perspective.main">
        <children xsi:type="basic:PartSashContainer" xmi:id="_sashRoot" elementId="iped.rcp.app.sash.root" horizontal="true">
          <children xsi:type="basic:PartStack" xmi:id="_stackLeft" elementId="iped.rcp.app.partstack.left" containerData="2500" selectedElement="_partEvidenceTree">
            <children xsi:type="basic:Part" xmi:id="_partEvidenceTree" elementId="iped.rcp.views.part.evidencetree" label="Evidence" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.trees.EvidenceTreePart"/>
            <children xsi:type="basic:Part" xmi:id="_partCategoryTree" elementId="iped.rcp.views.part.categorytree" label="Categories" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.trees.CategoryTreePart"/>
            <children xsi:type="basic:Part" xmi:id="_partBookmarkTree" elementId="iped.rcp.views.part.bookmarktree" label="Bookmarks" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.trees.BookmarkTreePart"/>
            <children xsi:type="basic:Part" xmi:id="_partAiFilters" elementId="iped.rcp.views.part.aifilters" label="AI Filters" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.trees.AiFiltersTreePart"/>
          </children>
          <children xsi:type="basic:PartSashContainer" xmi:id="_sashCenter" elementId="iped.rcp.app.sash.center" horizontal="false" containerData="5000">
            <children xsi:type="basic:Part" xmi:id="_partSearchBar" elementId="iped.rcp.views.part.searchbar" containerData="600" label="Search" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.SearchBarPart"/>
            <children xsi:type="basic:PartStack" xmi:id="_stackCenter" elementId="iped.rcp.app.partstack.center" containerData="6000" selectedElement="_partResults">
              <children xsi:type="basic:Part" xmi:id="_partResults" elementId="iped.rcp.views.part.results" label="Results" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.ResultsTablePart"/>
              <children xsi:type="basic:Part" xmi:id="_partGallery" elementId="iped.rcp.views.part.gallery" label="Gallery" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.gallery.GalleryPart"/>
              <children xsi:type="basic:Part" xmi:id="_partPreview" elementId="iped.rcp.viewers.part.preview" label="Preview" closeable="false" contributionURI="bundleclass://iped.rcp.viewers/iped.rcp.viewers.part.PreviewViewerPart"/>
              <children xsi:type="basic:Part" xmi:id="_partText" elementId="iped.rcp.viewers.part.text" label="Text" closeable="false" contributionURI="bundleclass://iped.rcp.viewers/iped.rcp.viewers.part.TextViewerPart"/>
              <children xsi:type="basic:Part" xmi:id="_partItemMetadata" elementId="iped.rcp.viewers.part.metadata" label="Metadata" closeable="false" contributionURI="bundleclass://iped.rcp.viewers/iped.rcp.viewers.part.MetadataViewerPart"/>
              <children xsi:type="basic:Part" xmi:id="_partHex" elementId="iped.rcp.viewers.part.hex" label="Hex" closeable="false" contributionURI="bundleclass://iped.rcp.viewers/iped.rcp.viewers.part.HexViewerPart"/>
              <children xsi:type="basic:Part" xmi:id="_partMap" elementId="iped.rcp.specialized.part.map" label="Map" closeable="false" contributionURI="bundleclass://iped.rcp.specialized/iped.rcp.specialized.parts.MapPart"/>
              <children xsi:type="basic:Part" xmi:id="_partGraph" elementId="iped.rcp.specialized.part.graph" label="Graph" closeable="false" contributionURI="bundleclass://iped.rcp.specialized/iped.rcp.specialized.parts.GraphPart"/>
              <children xsi:type="basic:Part" xmi:id="_partTimeline" elementId="iped.rcp.specialized.part.timeline" label="Timeline" closeable="false" contributionURI="bundleclass://iped.rcp.specialized/iped.rcp.specialized.parts.TimelinePart"/>
            </children>
            <children xsi:type="basic:PartStack" xmi:id="_stackBottom" elementId="iped.rcp.app.partstack.bottom" containerData="3400" selectedElement="_partAuxTables">
              <children xsi:type="basic:Part" xmi:id="_partAuxTables" elementId="iped.rcp.views.part.auxtables" label="Related Items" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.AuxTablesPart"/>
              <children xsi:type="basic:Part" xmi:id="_partTextHits" elementId="iped.rcp.viewers.part.hits" label="Hits" closeable="false" contributionURI="bundleclass://iped.rcp.viewers/iped.rcp.viewers.part.HitsViewerPart"/>
            </children>
          </children>
          <children xsi:type="basic:PartStack" xmi:id="_stackRight" elementId="iped.rcp.app.partstack.right" containerData="2500" selectedElement="_partMetadata">
            <children xsi:type="basic:Part" xmi:id="_partMetadata" elementId="iped.rcp.views.part.metadata" label="Metadata" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.metadata.MetadataPanelPart"/>
            <children xsi:type="basic:Part" xmi:id="_partFilters" elementId="iped.rcp.views.part.filterspanel" label="Filters" closeable="false" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.filters.FiltersPanelPart"/>
          </children>
        </children>
      </children>
    </children>
  </children>
  <!-- Triage keybindings (T046, FR-021): window-scoped e4 bindings; the
       table-local shortcuts (space/check variants) live in the parts — see
       specs/004-rcp-gui-migration/keybindings-map.md -->
  <bindingTables xmi:id="_bindingTableWindow" elementId="iped.rcp.app.bindingtable.window" bindingContext="_ctxWindow">
    <bindings xmi:id="_kbManageBookmarks" elementId="iped.rcp.app.kb.managebookmarks" keySequence="M1+B" command="_cmdManageBookmarks"/>
    <bindings xmi:id="_kbExit" elementId="iped.rcp.app.kb.exit" keySequence="M1+Q" command="_cmdExit"/>
  </bindingTables>
  <rootContext xsi:type="commands:BindingContext" xmi:id="_ctxDialogAndWindow" elementId="org.eclipse.ui.contexts.dialogAndWindow" name="In Dialogs and Windows">
    <children xmi:id="_ctxWindow" elementId="org.eclipse.ui.contexts.window" name="In Windows"/>
    <children xmi:id="_ctxDialog" elementId="org.eclipse.ui.contexts.dialog" name="In Dialogs"/>
  </rootContext>
  <handlers xmi:id="_handlerManageBookmarks" elementId="iped.rcp.app.handler.managebookmarks" contributionURI="bundleclass://iped.rcp.views/iped.rcp.views.handlers.ManageBookmarksHandler" command="_cmdManageBookmarks"/>
  <commands xmi:id="_cmdManageBookmarks" elementId="iped.rcp.command.managebookmarks" commandName="Manage Bookmarks"/>
  <handlers xmi:id="_handlerNewCase" elementId="iped.rcp.app.handler.newcase" contributionURI="bundleclass://iped.rcp.casecreation/iped.rcp.casecreation.handlers.NewCaseHandler" command="_cmdNewCase"/>
  <commands xmi:id="_cmdNewCase" elementId="iped.rcp.command.newcase" commandName="New Case"/>
  <handlers xmi:id="_handlerOpenCase" elementId="iped.rcp.app.handler.opencase" contributionURI="bundleclass://iped.rcp.casecreation/iped.rcp.casecreation.handlers.OpenCaseHandler" command="_cmdOpenCase"/>
  <commands xmi:id="_cmdOpenCase" elementId="iped.rcp.command.opencase" commandName="Open Case"/>
  <handlers xmi:id="_handlerManageProfiles" elementId="iped.rcp.app.handler.manageprofiles" contributionURI="bundleclass://iped.rcp.casecreation/iped.rcp.casecreation.handlers.ManageProfilesHandler" command="_cmdManageProfiles"/>
  <commands xmi:id="_cmdManageProfiles" elementId="iped.rcp.command.manageprofiles" commandName="Manage Profiles"/>
  <handlers xmi:id="_handlerExit" elementId="iped.rcp.app.handler.exit" contributionURI="bundleclass://iped.rcp.app/iped.rcp.app.handlers.QuitHandler" command="_cmdExit"/>
  <commands xmi:id="_cmdExit" elementId="iped.rcp.command.exit" commandName="Exit"/>
  <handlers xmi:id="_handlerAbout" elementId="iped.rcp.app.handler.about" contributionURI="bundleclass://iped.rcp.app/iped.rcp.app.handlers.AboutHandler" command="_cmdAbout"/>
  <commands xmi:id="_cmdAbout" elementId="iped.rcp.command.about" commandName="About"/>
  <addons xmi:id="_addonCommandService" elementId="org.eclipse.e4.core.commands.service" contributionURI="bundleclass://org.eclipse.e4.core.commands/org.eclipse.e4.core.commands.CommandServiceAddon"/>
  <addons xmi:id="_addonContextService" elementId="org.eclipse.e4.ui.contexts.service" contributionURI="bundleclass://org.eclipse.e4.ui.services/org.eclipse.e4.ui.services.ContextServiceAddon"/>
  <addons xmi:id="_addonBindingService" elementId="org.eclipse.e4.ui.bindings.service" contributionURI="bundleclass://org.eclipse.e4.ui.bindings/org.eclipse.e4.ui.bindings.BindingServiceAddon"/>
  <addons xmi:id="_addonCommandsModel" elementId="org.eclipse.e4.ui.workbench.commands.model" contributionURI="bundleclass://org.eclipse.e4.ui.workbench/org.eclipse.e4.ui.internal.workbench.addons.CommandProcessingAddon"/>
  <addons xmi:id="_addonContextsModel" elementId="org.eclipse.e4.ui.workbench.contexts.model" contributionURI="bundleclass://org.eclipse.e4.ui.workbench/org.eclipse.e4.ui.internal.workbench.addons.ContextProcessingAddon"/>
  <addons xmi:id="_addonBindingsModel" elementId="org.eclipse.e4.ui.workbench.bindings.model" contributionURI="bundleclass://org.eclipse.e4.ui.workbench.swt/org.eclipse.e4.ui.workbench.swt.util.BindingProcessingAddon"/>
  <addons xmi:id="_addonHandlerModel" elementId="org.eclipse.e4.ui.workbench.handler.model" contributionURI="bundleclass://org.eclipse.e4.ui.workbench/org.eclipse.e4.ui.internal.workbench.addons.HandlerProcessingAddon"/>
  <addons xmi:id="_addonDnD" elementId="org.eclipse.e4.ui.workbench.addons.swt.dnd" contributionURI="bundleclass://org.eclipse.e4.ui.workbench.addons.swt/org.eclipse.e4.ui.workbench.addons.dndaddon.DnDAddon"/>
  <addons xmi:id="_addonMinMax" elementId="org.eclipse.e4.ui.workbench.addons.swt.minmax" contributionURI="bundleclass://org.eclipse.e4.ui.workbench.addons.swt/org.eclipse.e4.ui.workbench.addons.minmax.MinMaxAddon"/>
  <addons xmi:id="_addonIpedUiEvents" elementId="iped.rcp.core.uievents" contributionURI="bundleclass://iped.rcp.core/iped.rcp.core.events.UiEventsAddon"/>
</application:Application>
