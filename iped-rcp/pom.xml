<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Tycho reactor for the Eclipse RCP analysis UI
         (feature 004-rcp-gui-migration, research R2).

         Build standalone:        mvn -f iped-rcp/pom.xml clean verify
         Or from the root POM:    mvn -P rcp ...

         The version is kept in lockstep with the root iped-parent. This
         reactor consumes the other IPED modules as binary dependencies from
         the local repository, so run `mvn clean install` at the repository
         root at least once before building it. -->

    <groupId>iped.rcp</groupId>
    <artifactId>iped-rcp-parent</artifactId>
    <version>4.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <tycho.version>4.0.10</tycho.version>
        <!-- SWT for PLAIN-JAR modules (iped.rcp.progress and its tests —
             research R10): same level as the Eclipse 4.32 target platform.
             The artifact id is platform-specific and resolved per builder OS
             by the swt-windows/swt-linux profiles below; OSGi bundles keep
             getting SWT from the target platform instead. -->
        <swt.version>3.126.0</swt.version>
        <!-- Kept in lockstep with the root iped-parent pom (property
             sleuthkit.version there). The iped.rcp.sleuthkit host bundle
             wraps exactly this artifact. -->
        <sleuthkit.version>4.12.0.p1</sleuthkit.version>
    </properties>

    <!-- Mirror the root iped-parent repositories. Needed standalone because
         iped.rcp.sleuthkit depends DIRECTLY on org.sleuthkit:sleuthkit, which
         is published on the iped-maven (gitlab) repo, not Maven Central; a
         direct dependency triggers a provenance re-check that fails without
         this repo declared. -->
    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Repository Switchboard</name>
            <layout>default</layout>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
        <repository>
            <id>mvn-repo</id>
            <url>https://gitlab.com/iped-project/iped-maven/raw/master</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <profiles>
        <!-- Maven profiles in a DEPENDENCY's pom are not activated when the
             dependency is consumed, so every plain-jar module that needs SWT
             references org.eclipse.platform:${swt.bundle} and the property is
             resolved here, in the consumer's own reactor parent. -->
        <profile>
            <id>swt-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <swt.bundle>org.eclipse.swt.win32.win32.x86_64</swt.bundle>
            </properties>
        </profile>
        <profile>
            <id>swt-linux</id>
            <activation>
                <os><family>unix</family></os>
            </activation>
            <properties>
                <swt.bundle>org.eclipse.swt.gtk.linux.x86_64</swt.bundle>
            </properties>
        </profile>
    </profiles>

    <modules>
        <module>target-platform</module>
        <!-- Phase 2 (T006/T007): engine wrapper + provisional extension API.
             Remaining bundles, features, products, samples and test modules
             are added by the rest of Phase 2+ (see
             specs/004-rcp-gui-migration/tasks.md). -->
        <!-- Sleuthkit datamodel host bundle: split out of iped.rcp.libs so
             org.sleuthkit.datamodel lives in its own OSGi class space. Built
             before the wrapper (independent of other reactor modules). -->
        <module>bundles/iped.rcp.sleuthkit</module>
        <module>bundles/iped.rcp.libs</module>
        <module>bundles/iped.rcp.api</module>
        <module>bundles/iped.rcp.core</module>
        <module>bundles/iped.rcp.viewers</module>
        <module>bundles/iped.rcp.views</module>
        <module>bundles/iped.rcp.specialized</module>
        <module>bundles/iped.rcp.progress</module>
        <module>bundles/iped.rcp.app</module>
        <module>features/iped.rcp.feature</module>
        <module>products/iped.rcp.product</module>
        <!-- Phase 8 (T051, US6): drop-in extension sample. Built by the
             reactor (so there is a jar to deploy) but intentionally NOT part
             of iped.rcp.feature — it ships via plugins-ext/ to prove the
             provisional extension contract (SC-007). -->
        <module>samples/iped.rcp.sample.view</module>
        <module>tests/iped.rcp.tests.parity</module>
        <module>tests/iped.rcp.tests.swtbot</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-maven-plugin</artifactId>
                <version>${tycho.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <!-- Generates OSGI-INF component XML from OSGi DS annotations
                     (research R6 — headless services as Declarative Services).
                     Defaults: annotations are injected into the compile
                     classpath (no Import-Package needed) and the
                     Service-Component header is added automatically. -->
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>tycho-ds-plugin</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <enabled>true</enabled>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.eclipse.tycho</groupId>
                <artifactId>target-platform-configuration</artifactId>
                <version>${tycho.version}</version>
                <configuration>
                    <target>
                        <artifact>
                            <groupId>iped.rcp</groupId>
                            <artifactId>iped-rcp</artifactId>
                            <version>${project.version}</version>
                        </artifact>
                    </target>
                    <executionEnvironment>JavaSE-21</executionEnvironment>
                    <!-- Treat plain Maven POM dependencies that are OSGi
                         bundles (e.g. iped.rcp.libs) as target content, so
                         Tycho bundles can Import-Package from the wrapper
                         (research R3). -->
                    <pomDependencies>consider</pomDependencies>
                    <!-- Product environments (research R1): Windows x64 and
                         Linux x64/GTK. macOS is out of scope (spec). -->
                    <environments>
                        <environment>
                            <os>win32</os>
                            <ws>win32</ws>
                            <arch>x86_64</arch>
                        </environment>
                        <environment>
                            <os>linux</os>
                            <ws>gtk</ws>
                            <arch>x86_64</arch>
                        </environment>
                    </environments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
