<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<!-- Target platform for the IPED RCP UI (feature 004-rcp-gui-migration,
     research R1/R2 — task T002).

     Pinned p2 repositories give reproducible builds; unit version 0.0.0
     means "highest version available in that (pinned) repository".

     NOTE: installable-unit ids are resolved only when the first consuming
     bundle is built (Phase 2, T006+) — the eclipse-target-definition
     packaging just publishes this file. If an IU id drifted in the chosen
     repositories, fix it there. -->
<target name="iped-rcp" sequenceNumber="1">
    <locations>
        <!-- Eclipse Platform 4.32 (2024-06): first release train requiring
             Java 21, matching the project baseline. e4 RCP runtime (SWT,
             JFace, e4 model/services, Equinox) + native launchers. -->
        <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
            <repository location="https://download.eclipse.org/releases/2024-06/"/>
            <unit id="org.eclipse.e4.rcp.feature.group" version="0.0.0"/>
            <unit id="org.eclipse.equinox.executable.feature.group" version="0.0.0"/>
            <!-- TEST RUNTIME ONLY (T014): tycho-surefire's UI harness
                 unconditionally provisions the 3.x IDE application bundle,
                 even though the launched application/product are ours (pure
                 e4). Not referenced by iped.rcp.feature, so the shipped
                 product stays e4-only. -->
            <unit id="org.eclipse.ui.ide.application" version="0.0.0"/>
        </location>
        <!-- Nebula Gallery (R12 — virtual gallery widget). -->
        <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
            <repository location="https://download.eclipse.org/nebula/releases/3.1.1/"/>
            <unit id="org.eclipse.nebula.widgets.gallery.feature.feature.group" version="0.0.0"/>
        </location>
        <!-- Nebula NatTable (R12 fallback for the virtual results table —
             included up-front per analysis finding I4). -->
        <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
            <repository location="https://download.eclipse.org/nattable/releases/2.4.0/repository/"/>
            <unit id="org.eclipse.nebula.widgets.nattable.core" version="0.0.0"/>
        </location>
        <!-- SWTBot (test-time only — R11). -->
        <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
            <repository location="https://download.eclipse.org/technology/swtbot/releases/4.2.0/"/>
            <unit id="org.eclipse.swtbot.feature.group" version="0.0.0"/>
        </location>
    </locations>
    <targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21"/>
</target>
