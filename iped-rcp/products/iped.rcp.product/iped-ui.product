<?xml version="1.0" encoding="UTF-8"?>
<?pde version="3.5"?>
<!-- IPED analysis UI product (T011, research R9). Feature-based, pure e4.
     - launcher "iped-ui": exec'd by the case-root shim (T054) with
       -vm <case>/iped/jre/bin
     - workspace: NO -data here (T043) — the lifecycle resolves the per-case
       area ~/.iped/ui-workspaces/<case-id> before the model loads (research
       R5); osgi.instance.area.default below is only the safety net if the
       resolver cannot run. An explicit -data still wins.
     - vmArgs carry the engine's Java 21 module opens AND the PNG-reader
       exports (same set Bootstrap passes to the processing JVM): the bundled
       patched PNG reader (png-reader-*.jar, package com.sun.imageio.plugins.png2)
       reaches into JDK-internal java.desktop packages, so without the two
       add-exports flags below the Swing ImageViewer/TiffViewer bridged into
       the content part throws IllegalAccessError when decoding its toolbar PNG
       icons (IconUtil/ImageIO.read). Also boot delegation for the JavaFX/AWT
       bridge (research R4), and osgi.bundlefile.limit raised well above the
       ~600 bundle files. The iped.rcp.libs fat bundle alone has a 475-entry
       Bundle-ClassPath (engine + Lucene + Tika + all deps embedded as nested
       jars); under the default MRU limit Equinox evicted and reopened those
       nested jars during class loading, re-parsing each ZIP central directory
       and pinning one core for tens of seconds at startup. Keeping them all
       open removes the thrashing (startup CPU settles in ~5s, RSS ~217MB vs
       ~1.3GB before). -->

<product name="IPED Analysis" uid="iped.rcp.product" id="iped.rcp.app.product" application="org.eclipse.e4.ui.workbench.swt.E4Application" version="4.4.0.qualifier" useFeatures="true" includeLaunchers="true">

   <configIni use="default">
   </configIni>

   <launcherArgs>
      <!-- -nosplash: the native Equinox splash deadlocks racily (~1 in 3
           launches) during framework startup — the main thread blocks in
           JNIBridge._update_splash (called from EclipseStarter.setStartLevel,
           before the SWT Display exists) and the workbench never renders. Seen
           on BOTH iped-ui.exe (GUI) and iped-uic.exe (console). Suppressing the
           splash is 100% reliable; the <splash> element below is kept only as
           the (now unused) resource anchor. Diagnose a hang with jstack: main
           stuck at _update_splash/setStartLevel = the splash race. -->
      <programArgs>-nosplash</programArgs>
      <vmArgs>--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.util.concurrent=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.math=ALL-UNNAMED
--add-opens=java.base/java.net=ALL-UNNAMED
--add-opens=java.base/java.io=ALL-UNNAMED
--add-opens=java.base/java.nio=ALL-UNNAMED
--add-opens=java.base/java.text=ALL-UNNAMED
--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
--add-exports=java.desktop/com.sun.imageio.plugins.common=ALL-UNNAMED
--add-exports=java.desktop/sun.awt.image=ALL-UNNAMED
-Djava.security.manager=allow
-Dorg.osgi.framework.bootdelegation=javafx.*,com.sun.*,jdk.*
-Dfile.encoding=UTF-8
-Dosgi.bundlefile.limit=2000
-Dosgi.instance.area.default=@user.home/.iped/ui-workspaces/default
      </vmArgs>
      <vmArgsLin>-Dsun.awt.xembedserver=true
      </vmArgsLin>
   </launcherArgs>

   <launcher name="iped-ui">
   </launcher>

   <splash location="iped.rcp.app"/>

   <vm>
   </vm>

   <features>
      <feature id="iped.rcp.feature"/>
      <feature id="org.eclipse.e4.rcp"/>
   </features>

   <configurations>
      <plugin id="org.apache.felix.scr" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.core.runtime" autoStart="true" startLevel="0" />
      <plugin id="org.eclipse.equinox.common" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.event" autoStart="true" startLevel="2" />
      <plugin id="org.eclipse.equinox.simpleconfigurator" autoStart="true" startLevel="1" />
      <!-- T045: EarlyStartup must set swt.autoScale BEFORE the application
           (and so before any SWT class) — eager start below the app level -->
      <plugin id="iped.rcp.app" autoStart="true" startLevel="4" />
   </configurations>

</product>
